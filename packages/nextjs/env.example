# ============================================
# AUTHENTICATION - PRIVY
# ============================================
# Get your app ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# ============================================
# BLOCKCHAIN RPC ENDPOINTS  
# ============================================
# TEA Sepolia RPC URL (optional - defaults to public endpoint)
NEXT_PUBLIC_TEA_RPC_URL=https://tea-sepolia.g.alchemy.com/public

# Alchemy API Key for other networks (optional)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# ============================================
# DATABASE
# ============================================
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/lunargistics

# ============================================
# AUTHENTICATION - NEXTAUTH (DEPRECATED - Being replaced by Privy)
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# ============================================
# EXTERNAL SERVICES
# ============================================
# Stripe API keys for payment processing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Venice AI API key
VENICE_API_KEY=

# Space-Track.org credentials for satellite tracking
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# ============================================
# MONITORING & ERROR TRACKING
# ============================================
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# STORAGE
# ============================================
# IPFS/Pinata credentials for decentralized storage
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# ============================================
# RATE LIMITING
# ============================================
# Redis URL for rate limiting (optional)
REDIS_URL=redis://localhost:6379

# ============================================
# EMAIL SERVICE
# ============================================
# Email service configuration (e.g., SendGrid, Mailgun)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@lunargistics.com
